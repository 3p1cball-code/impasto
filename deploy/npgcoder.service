[Unit]
Description=Non-Planar Gcoder (web app :6868)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/non-planar-gcoder
Environment=NPG_PORT=6868
Environment=NPG_HOST=0.0.0.0
Environment=NPG_DATA=%h/non-planar-gcoder/data
ExecStart=%h/non-planar-gcoder/.venv/bin/python -m npg.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
